<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>CKFHardMode</AssemblyName>
    <Version>4.1.1</Version>
    <LangVersion>latest</LangVersion>
    <!-- BepInEx loads plugins by reflection; no entry point needed -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!--
    Point this at your game install. Everything else resolves from it.
    Example:
      <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Cyber Knights Flashpoint</GameDir>
  -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Cyber Knights Flashpoint</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <CoreDir>$(BepInExDir)\core</CoreDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 6 IL2CPP core -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(CoreDir)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(CoreDir)\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(CoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    THE CONFIG FILES ARE NOT IN THIS ASSEMBLY. This project embeds no
    resources: the DLL is the engine and nothing else.

    The config files a player needs travel as loose files in the release zip,
    under BepInEx\config\, and extracting the zip is what puts them on disk.
    scripts/make_release.py collects them and refuses to build a release if
    any is missing. They come from two places:

      <game>\BepInEx\config\       the live config the config editor edits
                                   (gui/settings.json), or a directory named
                                   on make_release.py's command line: the
                                   names in CONFIG_FILES plus the other
                                   .csv/.tsv/.json files in ckf.hardmode.d.
                                   The repo holds no copy.
      release/ckf.hardmode.cfg.in  the switches ([General] Enabled and one
                                   [Slices] key per slice), rendered by
                                   make_release.py with the version filled in.

    Retuning the mod is editing the live config and re-running
    make_release.py, with no dotnet build unless the C# changed.

    Defaults.cs writes nothing. It checks that the expected files are on disk
    and reports what is missing.

    <Version> matches Plugin.PluginVersion and changes only for a public
    release; make_release.py refuses a build where the two disagree.
  -->

  <!-- UI text travels in the DLL; runtime registration adds only new locale keys. -->
  <ItemGroup>
    <EmbeddedResource Include="Locales\en-US.json" LogicalName="CKFHardMode.WeaponLocale.en-US.json" />
  </ItemGroup>

  <!-- Copy the built plugin straight into the game on build -->
  <Target Name="DeployToGame" AfterTargets="Build"
          Condition="Exists('$(BepInExDir)\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(BepInExDir)\plugins" />
  </Target>

</Project>

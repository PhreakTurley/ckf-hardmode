<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>CKFHardMode</AssemblyName>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <!-- BepInEx loads plugins by reflection; no entry point needed -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!--
    Point this at your game install. Everything else resolves from it.
    Example:
      <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Cyber Knights Flashpoint</GameDir>
  -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Cyber Knights Flashpoint</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <CoreDir>$(BepInExDir)\core</CoreDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 6 IL2CPP core -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(CoreDir)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(CoreDir)\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(CoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    THE SHIPPED DEFAULTS ARE NOT IN THIS ASSEMBLY. This project embeds no
    resources at all: the DLL is the engine and nothing else.

    The eight config files a player needs travel as loose files in the release
    zip, under BepInEx\config\, and extracting the zip is what puts them on
    disk. scripts/make_release.py collects them and refuses to build a release
    if any is missing.

    They come from two places:

      <game>\BepInEx\config\       the live config, the directory the config
                                   editor edits (gui/settings.json), or one
                                   named on make_release.py's command line.
                                   Seven files by the names in CONFIG_FILES,
                                   plus any other .csv/.tsv/.json in
                                   ckf.hardmode.d. The repo holds no copy: the
                                   ones in mods/CKFHardMode/defaults/ and
                                   overlays/ were deleted 2026-09-11.
      release/ckf.hardmode.cfg.in  the one-key master switch, rendered by
                                   make_release.py with the version filled in.

    What this buys: retuning the mod is editing the live config and re-running
    make_release.py. No dotnet build in the loop unless the C# changed.

    Defaults.cs no longer writes anything. It checks that the eight files are on
    disk and reports what is missing, which is the only thing left to say once
    the zip carries them.
  -->

  <!-- Copy the built plugin straight into the game on build -->
  <Target Name="DeployToGame" AfterTargets="Build"
          Condition="Exists('$(BepInExDir)\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins" />
    <Message Importance="high" Text="Deployed $(TargetFileName) -> $(BepInExDir)\plugins" />
  </Target>

</Project>
